APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://copymint:copymint_local_only@localhost:5432/copymint
SIGNER_DATABASE_URL=postgresql+psycopg://copymint_signer:signer_local_only@localhost:5432/copymint
QUEUE_URL=redis://localhost:6379/0

# Use disposable development credentials only.
TELEGRAM_BOT_TOKEN=000000000:replace_with_development_token
TELEGRAM_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
TELEGRAM_PLATFORM_OWNER_IDS=[123456789]

CHAINSTACK_ETHEREUM_HTTP_URL=https://ethereum-mainnet.core.chainstack.com/replace_me
CHAINSTACK_ETHEREUM_WSS_URL=wss://ws-ethereum-mainnet.core.chainstack.com/replace_me
ETHEREUM_CHAIN_ID=1
ETHEREUM_REORG_LOOKBACK=64
INDEXER_INITIAL_CHUNK=2000
INDEXER_MAX_CHUNK=5000

SIGNER_INTERNAL_URL=http://localhost:10001
SIGNER_AUTH_SECRET=replace_with_at_least_32_random_characters
AWS_REGION=replace_me
AWS_KMS_KEY_ARN=arn:aws:kms:replace_me
MAX_EXECUTION_WALLETS_PER_WORKSPACE=1

RELEASE_EXECUTION_CEILING=paper
